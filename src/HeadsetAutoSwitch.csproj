<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and 11: nothing for users to install. -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>HeadsetAutoSwitch</RootNamespace>
    <AssemblyName>HeadsetAutoSwitch</AssemblyName>
    <Version>0.1.0</Version>
    <Product>HeadsetAutoSwitch</Product>
    <Description>Switches Windows audio when a wireless headset turns on or off</Description>
    <Copyright>Copyright (c) 2026 Dasio</Copyright>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- One self-contained .exe: no .pdb or .exe.config next to it in Release. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HeadsetAutoSwitch.Tests" />
  </ItemGroup>

</Project>
