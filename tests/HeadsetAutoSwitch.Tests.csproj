<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests cover the parts that don't need Windows or hardware; they link those source files
       directly so they also run on macOS/Linux. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <!-- On Windows also run against .NET Framework 4.8, which is what the app actually uses. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net48</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>HeadsetAutoSwitch.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../src/DeviceName.cs" Link="src/DeviceName.cs" />
    <Compile Include="../src/HeadsetControlOutput.cs" Link="src/HeadsetControlOutput.cs" />
    <Compile Include="../src/Config.cs" Link="src/Config.cs" />
    <Compile Include="../src/IniFile.cs" Link="src/IniFile.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Include="../src/Polyfills.cs" Link="src/Polyfills.cs" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
